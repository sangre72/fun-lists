{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sangre72/fun-lists/video.schema.json",
  "title": "fun-lists video.json",
  "description": "Address list only: video platforms (and later public channels/playlists/videos). No tokens, no personal data.",
  "type": "object",
  "required": [
    "version",
    "updated",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 2
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{2,40}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "url": {
            "type": "string",
            "pattern": "^https://(www\\.youtube\\.com|www\\.twitch\\.tv)(/.*)?$",
            "description": "Plain public address on youtube.com or twitch.tv (no query tokens)"
          },
          "type": {
            "enum": [
              "platform",
              "channel",
              "playlist",
              "video"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  }
}
