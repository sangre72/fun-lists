{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sangre72/fun-lists/radio.schema.json",
  "title": "fun-lists radio.json",
  "type": "object",
  "required": ["version", "updated", "countries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "countries": {
      "description": "Recommended countries in display order; each with its stations in display order.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "nameKo", "flag", "stations"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "nameKo": { "type": "string", "minLength": 1 },
          "flag": { "type": "string", "minLength": 1 },
          "stations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "url"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z]{2}-[a-z0-9-]{2,40}$" },
                "name": { "type": "string", "minLength": 1, "maxLength": 160 },
                "genre": { "type": "string", "maxLength": 40 },
                "url": { "type": "string", "pattern": "^https?://", "description": "The broadcaster's own public stream URL. No tokens, session parameters, relay or proxy URLs." },
                "homepage": { "type": "string", "pattern": "^https?://" },
                "lossless": { "type": "boolean" },
                "codec": { "type": "string", "maxLength": 12, "description": "As listed by the broadcaster (informational)" },
                "bitrateKbps": { "type": "integer", "minimum": 8, "maximum": 2000, "description": "As listed (informational)" }
              }
            }
          }
        }
      }
    }
  }
}
